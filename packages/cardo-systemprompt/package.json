{
  "name": "@cardo/cardo-systemprompt",
  "version": "0.5.0",
  "private": true,
  "description": "App-wide working rules injected into the system prompt as a pi-agent extension.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "pnpm run build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
