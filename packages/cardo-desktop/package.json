{
  "name": "@cardo/cardo-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cardo desktop shell: supervises a bundled DeepSeek Harness (dsh) runtime and hosts its Web UI in an Electron window. Self-contained — owns its own DSH_HOME under the app's user-data dir, never touches ~/.dsh.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "dev": "electron .",
    "start": "electron .",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "package": "pnpm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@cardo/cardo-updater": "workspace:*",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "dshmarket": "1.9.0",
    "dsh-notifier": "0.6.2",
    "dsh-better-sidebar": "0.12.2",
    "dsh-file-upload": "0.4.2",
    "dsh-lan-gateway": "0.2.1",
    "dsh-find-plugin": "0.3.6",
    "dsh-subagent-model-picker": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
