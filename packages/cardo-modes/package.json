{
  "name": "@cardo/cardo-modes",
  "version": "0.1.0",
  "private": true,
  "description": "Cardo session modes as a DeepSeek Harness plugin: plan mode (native ctx.planMode) plus debug mode (logged debug/mode state, debug:policy section, /debug command).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test:pbt": "pnpm run build && tsc -p tsconfig.test.json && node --test \"test/pbt/**/*.test.mts\""
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.9.0"
  }
}
