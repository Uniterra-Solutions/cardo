{
  "name": "@cardo/jovaltus",
  "version": "0.1.0",
  "private": true,
  "description": "Jovaltus subagent-driven pipeline (plan/execute/simplify/review) as a pi-agent extension.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
