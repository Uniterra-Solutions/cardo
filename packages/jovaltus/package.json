{
  "name": "@cardo/jovaltus",
  "version": "0.1.0",
  "private": true,
  "description": "Jovaltus subagent-driven pipeline (plan/execute/simplify/review) as a pi-agent extension.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-prompts.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test:pbt": "pnpm run build && tsc -p tsconfig.test.json && node --test \"test/pbt/**/*.test.mts\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.9.0"
  }
}
