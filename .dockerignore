# Docker build context for this repo (used by scripts/verify-cli-container).
# The CLI-flow harness starts from a pristine source archive — no git
# metadata, no installed deps, no build artifacts, no local runtime trees.
.git
node_modules
**/node_modules
**/dist
**/*.tsbuildinfo
# The provider's esbuild bundle (lib/index.js) is a build artifact; the
# harness must start from a pristine tree that has NOT been built locally,
# otherwise the very regression it exists to catch (setup build missing the
# bundle) is masked by stale local outputs.
packages/uniterra-provider/lib
vendor/dsh-runtime
.plan
.hermes
.env
.env.*
*.log
